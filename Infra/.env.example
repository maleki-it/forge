# Copy to .env and edit (never commit .env)

# DigitalOcean API token: https://cloud.digitalocean.com/account/api/tokens
DO_API_TOKEN=your_digitalocean_token_here

# Region (default: nyc1)
# DO_REGION=sfo3

# SSH — private key path; public key must be same path + ".pub"
SSH_PRIVATE_KEY_PATH=/Users/name/.ssh/id_rsa

# Name of your key in DigitalOcean → Settings → Security → SSH Keys
DO_SSH_KEY_NAME=username-pc

# --- Kubernetes versions ---
# Minor version for apt repo (kubelet, kubeadm, kubectl packages)
K8S_VERSION=1.34

# Exact patch for kubeadm init (latest stable 1.34: see https://kubernetes.io/releases/)
KUBERNETES_VERSION=1.34.8

# --- Cluster shape ---
# true  = 2 droplets (master + worker) ~$48/month
# false = 1 droplet (master only)      ~$24/month — no worker VM, no join step
WORKER_NODE=true
