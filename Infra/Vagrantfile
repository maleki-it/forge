# frozen_string_literal: true

# Vagrant + DigitalOcean Kubernetes (kubeadm)
# Configure via .env: K8S_VERSION, KUBERNETES_VERSION, WORKER_NODE

env_file = File.join(__dir__, ".env")
if File.exist?(env_file)
  File.foreach(env_file) do |line|
    line = line.strip
    next if line.empty? || line.start_with?("#")

    key, value = line.split("=", 2)
    ENV[key] = value.strip if key && value
  end
end

def self.env_truthy?(val, default: true)
  v = val.nil? || val.to_s.strip.empty? ? (default ? "true" : "false") : val.to_s.strip.downcase
  %w[true 1 yes on].include?(v)
end

DO_TOKEN = ENV["DO_API_TOKEN"]
if DO_TOKEN.nil? || DO_TOKEN.empty?
  raise <<~MSG
    Missing DO_API_TOKEN.
    Copy .env.example to .env and set your DigitalOcean API token.
  MSG
end

DO_REGION = ENV.fetch("DO_REGION", "nyc1")
DO_SIZE   = "s-2vcpu-4gb"
DO_IMAGE  = "ubuntu-22-04-x64"

WORKER_NODE = env_truthy?(ENV["WORKER_NODE"], default: true)

raw_k8s = ENV.fetch("K8S_VERSION", "1.29")
K8S_MINOR = raw_k8s[%r{\A(\d+\.\d+)}] || raw_k8s
KUBERNETES_VERSION = ENV["KUBERNETES_VERSION"].to_s.strip
KUBERNETES_VERSION = raw_k8s if KUBERNETES_VERSION.empty? && raw_k8s.match?(/\d+\.\d+\.\d+/)

PROVISION_ENV = {
  "K8S_VERSION" => K8S_MINOR,
  "KUBERNETES_VERSION" => KUBERNETES_VERSION,
  "WORKER_NODE" => WORKER_NODE ? "true" : "false"
}.freeze

SSH_PRIVATE_KEY = File.expand_path(ENV.fetch("SSH_PRIVATE_KEY_PATH", "~/.ssh/id_rsa"))

unless File.exist?(SSH_PRIVATE_KEY)
  raise "SSH private key not found: #{SSH_PRIVATE_KEY}\nSet SSH_PRIVATE_KEY_PATH in .env"
end

ssh_public = "#{SSH_PRIVATE_KEY}.pub"
unless File.exist?(ssh_public)
  raise <<~MSG
    SSH public key not found: #{ssh_public}
    If your public key is id_rsa.pup, run: cp ~/.ssh/id_rsa.pup ~/.ssh/id_rsa.pub
  MSG
end

DO_BOX_URL = "https://github.com/devopsgroup-io/vagrant-digitalocean/raw/master/box/digital_ocean.box"

DO_SSH_KEY_NAME = ENV["DO_SSH_KEY_NAME"].to_s.strip
if DO_SSH_KEY_NAME.empty?
  require "json"
  require "net/http"

  fp_out = `ssh-keygen -lf "#{ssh_public}" -E md5 2>/dev/null`.strip
  local_fp = fp_out.split[1]&.sub(/\AMD5:/i, "")&.downcase

  uri = URI("https://api.digitalocean.com/v2/account/keys")
  res = Net::HTTP.start(uri.host, uri.port, use_ssl: true) do |http|
    req = Net::HTTP::Get.new(uri)
    req["Authorization"] = "Bearer #{DO_TOKEN}"
    http.request(req)
  end
  keys = JSON.parse(res.body)["ssh_keys"] || []
  match = keys.find { |k| k["fingerprint"].to_s.downcase == local_fp }
  DO_SSH_KEY_NAME = match["name"] if match
end
if DO_SSH_KEY_NAME.nil? || DO_SSH_KEY_NAME.empty?
  raise <<~MSG
    Set DO_SSH_KEY_NAME in .env (e.g. DO_SSH_KEY_NAME=malek-pc)
  MSG
end

Vagrant.configure("2") do |config|
  config.vm.synced_folder ".", "/vagrant", type: "rsync", rsync__args: ["--verbose"]

  do_provider = lambda do |provider, override|
    override.vm.box = "digital_ocean"
    override.vm.box_url = DO_BOX_URL
    override.ssh.private_key_path = SSH_PRIVATE_KEY
    override.ssh.insert_key = false
    override.nfs.functional = false
    override.vm.allowed_synced_folder_types = :rsync

    provider.token   = DO_TOKEN
    provider.region  = DO_REGION
    provider.size    = DO_SIZE
    provider.image   = DO_IMAGE
    provider.private_networking = WORKER_NODE
    provider.ssh_key_name = DO_SSH_KEY_NAME
  end

  config.vm.define "master" do |master|
    master.vm.hostname = "k8s-master"
    master.vm.provider :digital_ocean, &do_provider

    master.vm.provision "shell", name: "common",
                                 path: "scripts/common.sh",
                                 env: PROVISION_ENV
    master.vm.provision "shell", name: "master",
                                 path: "scripts/master.sh",
                                 env: PROVISION_ENV
  end

  if WORKER_NODE
    config.vm.define "worker" do |worker|
      worker.vm.hostname = "k8s-worker"
      worker.vm.provider :digital_ocean, &do_provider

      worker.vm.provision "shell", name: "common",
                                   path: "scripts/common.sh",
                                   env: PROVISION_ENV
      worker.vm.provision "shell",
                          name: "worker-join",
                          path: "scripts/worker.sh",
                          env: PROVISION_ENV.merge("JOIN_CMD" => ENV.fetch("JOIN_CMD", ""))
    end
  end
end
